# ==========================================
# ARGUS AI - Environment Variables Reference
# ==========================================

# ------------------------------------------
# 1. Google OAuth 2.0 Identity (Optional)
# ------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Web Client ID
# Powers Google Identity Services (GIS) native sign-in popup
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ------------------------------------------
# 2. IBM watsonx / Granite Guardian (Optional)
# ------------------------------------------
# Obtain from IBM Cloud Console (https://cloud.ibm.com)
# If left blank, ARGUS automatically activates its built-in offline Grounded IBM Granite Adapter
WATSONX_API_KEY=your_ibm_cloud_iam_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_guid_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# ------------------------------------------
# 3. Server Configuration (Optional)
# ------------------------------------------
PORT=8000
